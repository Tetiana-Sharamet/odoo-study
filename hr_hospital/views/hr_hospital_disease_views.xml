<odoo>
    <record id="view_disease_tree" model="ir.ui.view">
        <field name="name">Disease Tree</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>
    <record id="view_disease_form" model="ir.ui.view">
        <field name="name">Disease Form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <field name="parent_id"/>
            </form>
        </field>
    </record>

     <record id="hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">hr.hospital.disease.search (hr_hospital_disease)</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search string="Filters">
                <field name="name"/>

                <group expand="0" string="Group By">
                    <filter string="Parent" name="status" domain="[]" context="{'group_by':'parent_id'}"/>
                </group>

                <searchpanel>
                    <field name="parent_id" string="Filter" icon="fa-users" select="multi"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_disease" model="ir.actions.act_window">
        <field name="name">Disease</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">tree,form</field>
    </record>
     <menuitem id="hr_hospital_menu_disease"
                  action="action_disease"
                  parent="hr_hospital_main_menu"
                  name="Diseases" sequence="200"/>
</odoo>

