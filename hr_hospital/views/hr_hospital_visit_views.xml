<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree ()</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="visit_status"/>
                <field name="scheduled_date"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="disease_id"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form ()</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="visit_status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="doctor_id"/>
                            <field name="patient_id"/>
                            <field name="disease_id"/>
                            <field name="diagnosis_ids"/>
                            <field name="scheduled_date"/>
                            <field name="completed_date"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ohr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Example" sample="1" disable_linking="1" display_quantity="1">
                <field name="scheduled_date" interval="month" type="col"/>
                <field name="doctor_id" type="row"/>
                <field name="visit_status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Filters">
                <field name="doctor_id" />

                <filter name="filter_date" date="scheduled_date"/>
                <group expand="0" string="Group By">
                    <filter string="Visit status" name="status" domain="[]" context="{'group_by':'visit_status'}"/>
                </group>

                <searchpanel>
                    <field name="doctor_id" string="Filter by Doctors" icon="fa-users" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <calendar string="Visit date" create="1" quick_create="1" mode="month" scales="day,week,month,year"
                      create_name_field="scheduled_date" color="visit_status" date_start="scheduled_date"
                      event_open_popup="True">
                <field name="doctor_id" avatar_field="avatar_128"/>
                <field name="visit_status" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <record id="action_hr_hospital_visit_window" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">tree,form,pivot,calendar</field>
    </record>

    <menuitem id="hr_hospital_menu_visit"
              action="action_hr_hospital_visit_window"
              parent="hr_hospital_main_menu"
              name="Visits" sequence="200"/>
</odoo>
