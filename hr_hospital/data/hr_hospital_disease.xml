<odoo>
    <record id="disease_infectious" model="hr.hospital.disease">
        <field name="name">Infectious Diseases</field>
        <field name="description">Diseases caused by pathogens such as bacteria, viruses, or fungi.</field>
    </record>

    <record id="disease_chronic" model="hr.hospital.disease">
        <field name="name">Chronic Diseases</field>
        <field name="description">Long-lasting diseases that persist over time.</field>
    </record>
    <record id="disease_flu" model="hr.hospital.disease">
        <field name="name">Flu</field>
        <field name="parent_id" ref="disease_infectious"/>
        <field name="description">A viral infection that attacks your respiratory system.</field>
    </record>

    <record id="disease_tuberculosis" model="hr.hospital.disease">
        <field name="name">Tuberculosis</field>
        <field name="parent_id" ref="disease_infectious"/>
        <field name="description">A bacterial infection that primarily affects the lungs.</field>
    </record>

    <record id="disease_arthritis" model="hr.hospital.disease">
        <field name="name">Arthritis</field>
        <field name="parent_id" ref="disease_chronic"/>
        <field name="description">A condition that causes inflammation and stiffness in the joints.</field>
    </record>

    <record id="disease_diabetes" model="hr.hospital.disease">
        <field name="name">Diabetes</field>
        <field name="parent_id" ref="disease_chronic"/>
        <field name="description">A disease that affects the body’s ability to produce or respond to insulin.</field>
    </record>
</odoo>
