         <field name="visit_id" ref="demo_patient_visit_30"/>
        <field name="disease_id" ref="disease_diabetes"/>
    </record>

    <record id="demo_disease_6" model="hr.hospital.diagnosis">
        <field name="name">Stroke</field>
        <field name="description">A sudden interruption of blood flow to the brain, causing brain cell damage.</field>
         <field name="visit_id" ref="demo_patient_visit_20"/>
        <field name="disease_id" ref="disease_diabetes"/>
    </record>
</odoo>
