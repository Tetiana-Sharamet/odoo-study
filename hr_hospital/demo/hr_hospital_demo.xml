    <record id="patient_40" model="hr.hospital.patient">
        <field name="first_name">Alice</field>
        <field name="last_name">Milano</field>
        <field name="gender">female</field>
         <field name="birth_date" eval="datetime(1991, 11, 1)"/>
        <field name="doctor_id" ref="doctor_20"/>
    </record>

    <record id="demo_patient_visit_10" model="hr.hospital.visit">
        <field name="patient_id" ref="patient_30"/>
        <field name="doctor_id" ref="doctor_30"/>
        <field name="scheduled_date" eval="datetime(2025, 3, 1, 10, 0)"/>
    </record>

    <record id="demo_patient_visit_20" model="hr.hospital.visit">
        <field name="patient_id" ref="patient_20"/>
        <field name="doctor_id" ref="doctor_20"/>
        <field name="scheduled_date" eval="datetime(2025, 3, 15, 10, 0)"/>
    </record>

    <record id="demo_patient_visit_30" model="hr.hospital.visit">
        <field name="patient_id" ref="patient_10"/>
        <field name="doctor_id" ref="doctor_10"/>
        <field name="scheduled_date" eval="datetime(2025, 3, 20, 10, 0)"/>
    </record>

    <record id="demo_patient_visit_40" model="hr.hospital.visit">
        <field name="patient_id" ref="patient_20"/>
        <field name="doctor_id" ref="doctor_10"/>
        <field name="scheduled_date" eval="datetime(2025, 3, 20, 13, 0)"/>
    </record>

    <record id="demo_disease_10" model="hr.hospital.diagnosis">
        <field name="name">Flu</field>
        <field name="description">An acute respiratory illness caused by the influenza virus.</field>
        <field name="visit_id" ref="demo_patient_visit_30"/>
        <field name="disease_id" ref="disease_flu"/>
    </record>

    <record id="demo_disease_20" model="hr.hospital.diagnosis">
        <field name="name">Tuberculosis</field>
        <field name="description">A chronic infectious disease that primarily affects the lungs.</field>
        <field name="visit_id" ref="demo_patient_visit_20"/>
        <field name="disease_id" ref="disease_tuberculosis"/>
    </record>

    <record id="demo_disease_3" model="hr.hospital.diagnosis">
        <field name="name">Hypertension</field>
        <field name="description">A condition in which the blood pressure in the arteries is persistently elevated.
        </field>
        <field name="visit_id" ref="demo_patient_visit_10"/>
        <field name="disease_id" ref="disease_diabetes"/>
    </record>

    <record id="demo_disease_4" model="hr.hospital.diagnosis">
        <field name="name">Diabetes</field>
        <field name="description">A disease that affects the body's ability to regulate blood sugar levels.</field>
        <field name="visit_id" ref="demo_patient_visit_10"/>
        <field name="disease_id" ref="disease_diabetes"/>
    </record>

    <record id="demo_disease_5" model="hr.hospital.diagnosis">
        <field name="name">Asthma</field>
