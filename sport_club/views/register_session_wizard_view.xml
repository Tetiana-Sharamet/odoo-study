<odoo>
    <record id="view_register_session_wizard" model="ir.ui.view">
        <field name="name">sport.club.register.session.wizard.form</field>
        <field name="model">sport.club.register.session.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Session">
                <group>
                    <field name="partner_id"/>
                    <field name="coach_id"/>
                    <field name="session_date"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button string="Register" type="object" name="action_register_session" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
