<odoo>
    <record id="view_training_session_tree" model="ir.ui.view">
        <field name="name">sport.club.training.session.tree</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="coach_id"/>
                <field name="session_date"/>
                <field name="session_type"/>
            </tree>
        </field>
    </record>

    <record id="view_training_session_form" model="ir.ui.view">
        <field name="name">sport.club.training.session.form</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="coach_id"/>
                        <field name="location_id"/>
                        <field name="session_date"/>
                        <field name="session_type"/>
                        <field name="group_category">
                            <visibility_condition>'group' == session_type</visibility_condition>
                        </field>
                         <field name="remaining_seats"/>
                        <field name="member_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
     <record id="view_sport_club_training_session_calendar" model="ir.ui.view">
        <field name="name">sport.club.training.session.calendar</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <calendar string="Training Sessions Calendar" date_start="session_date" color="coach_id">
                <field name="name"/>
                <field name="coach_id"/>
                <field name="member_ids"/>
            </calendar>
        </field>
    </record>

    <record id="action_training_session" model="ir.actions.act_window">
        <field name="name">Training Sessions</field>
        <field name="res_model">sport.club.training.session</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>

    <menuitem id="menu_sport_club_training"  name="Trainings"
              parent="sport_club_main_menu"
              action="action_training_session"
              sequence="20"/>

</odoo>
