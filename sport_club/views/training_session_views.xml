<odoo>
    <record id="view_training_session_tree" model="ir.ui.view">
        <field name="name">sport.club.training.session.tree</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="coach_id"/>
                <field name="session_date"/>
                <field name="session_type"/>
            </tree>
        </field>
    </record>

    <record id="view_training_session_form" model="ir.ui.view">
        <field name="name">sport.club.training.session.form</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="coach_id"/>
                        <field name="location_id"/>
                        <field name="session_date"/>
                        <field name="session_type"/>
                        <field name="group_category">
                            <visibility_condition>'group' == session_type</visibility_condition>
                        </field>
                         <field name="remaining_seats"/>
                        <field name="visit_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="view_sport_club_training_session_calendar" model="ir.ui.view">
        <field name="name">sport.club.training.session.calendar</field>
        <field name="model">sport.club.training.session</field>
        <field name="arch" type="xml">
            <calendar string="Training Sessions Calendar"
                     quick_create="0" mode="week" scales="day,week,month,year"
                     create_name_field="session_date" color="coach_id" date_start="session_date"
                     event_open_popup="False">
                <field name="name"/>
                <field name="coach_id"/>
                <field name="group_category"/>
            </calendar>
        </field>
    </record>

    <record id="view_training_session_search" model="ir.ui.view">
    <field name="name">sport.club.training.session.search</field>
    <field name="model">sport.club.training.session</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="coach_id"/>
<!--            <filter name="filter_my" string="Мої тренування" domain="[('coach_id','=',uid)]"/>-->
            <separator/>

            <filter string="Group" name="group_sessions" domain="[('session_type','=','group')]"/>
            <filter string="Personal" name="personal_sessions" domain="[('session_type','=','personal')]"/>
            <searchpanel view_types="calendar">
                    <field name="coach_id" string="Filter by trainers" icon="fa-users" select="multi"
                           enable_counters="1"/>

                    <field name="group_category" string="Filter by types" icon="fa-bolt" select="multi"
                           enable_counters="1"/>
                </searchpanel>
        </search>
    </field>
</record>

    <record id="action_training_session" model="ir.actions.act_window">
        <field name="name">Training Sessions</field>
        <field name="res_model">sport.club.training.session</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="search_view_id" ref="view_training_session_search"/>
    </record>

    <menuitem id="menu_sport_club_training"  name="Trainings"
              parent="sport_club_main_menu"
              action="action_training_session"
              sequence="20"/>
</odoo>
