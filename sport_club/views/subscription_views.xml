<odoo>
    <record id="view_subscription_tree" model="ir.ui.view">
        <field name="name">sport.club.subscription.tree</field>
        <field name="model">sport.club.subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="member_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="subscription_type_id"/>
                <field name="price" sum="Total"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>


    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">sport.club.subscription.form</field>
        <field name="model">sport.club.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_renew_wizard"
                            string="Renew"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="member_id"/>
                            <field name="start_date"/>
                            <field name="duration_months"/>
                            <field name="end_date" readonly="1"/>
                            <field name="subscription_type_id"/>
                            <field name="price"/>
                            <field name="is_active" readonly="1"/>
                        </group>
                        <group>
                            <field name="group_sessions_left"/>
                            <field name="personal_sessions_left"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_pivot" model="ir.ui.view">
        <field name="name">sport.club.subscription.pivot</field>
            <field name="model">sport.club.subscription</field>
                <field name="arch" type="xml">
                    <pivot string="Pivot Example" sample="1" disable_linking="1" display_quantity="1">
                        <field name="start_date" interval="month" type="col"/>
                        <field name="subscription_type_id" type="row"/>
                        <field name="price" type="col"/>
                     </pivot>
                </field>
    </record>



    <record id="view_club_subscription_graph" model="ir.ui.view">
    <field name="name">club.subscription.graph</field>
    <field name="model">sport.club.subscription</field>
    <field name="arch" type="xml">
         <graph string="Graph" type="bar">
                <field name="price"/>
                <field name="start_date" interval="month"/>
            </graph>
    </field>
</record>

     <record id="view_subscription_search" model="ir.ui.view">
    <field name="name">sport.club.subscription.search</field>
    <field name="model">sport.club.subscription</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="member_id"/>
<!--            <filter name="filter_my" string="Мої тренування" domain="[('coach_id','=',uid)]"/>-->
            <separator/>

            <searchpanel>
                    <field name="member_id" string="Filter by member" icon="fa-users" select="multi"
                           enable_counters="1"/>

                    <field name="subscription_type_id" string="Filter by types" icon="fa-bolt" select="multi"
                           enable_counters="1"/>
                </searchpanel>
        </search>
    </field>
</record>
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">sport.club.subscription</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>

    <menuitem id="menu_sport_club_subscriptions"
              name="Subscriptions"
              parent="sport_club_menu_main_subscription"
              action="action_subscription"
              sequence="40"/>
</odoo>
