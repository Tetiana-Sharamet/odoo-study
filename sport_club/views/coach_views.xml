<odoo>
    <record id="view_sport_club_coach_tree" model="ir.ui.view">
        <field name="name">sport.club.coach.tree</field>
        <field name="model">sport.club.coach</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="specialty"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_sport_club_coach_form" model="ir.ui.view">
        <field name="name">sport.club.coach.form</field>
        <field name="model">sport.club.coach</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="is_active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <newline/>
                    <group colspan="3">

                        <group>
                            <field name="is_active" invisible="0"/>
                            <field name="partner_id" invisible="0"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>

                        </group>
                        <group>
                            <field name="image_512" widget='image' class="oe_right image_wrapper"
                                   nolabel="1" style="height: 150px; width: 150px;"
                                   options='{"zoom": true, "preview_image":"avatar_256"}'/>

                            <separator/>
                            <field name="specialty"/>
                            <separator/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trener`s info">
                            <group>
                                <field name="biography"/>
                            </group>
                        </page>

                        <page string="Future Schedule">
                            <field name="future_schedule_ids">
                                <tree editable="bottom" default_order="session_date asc">
                                    <field name="name"/>
                                    <field name="session_date"/>
                                    <field name="group_category"/>
                                    <field name="duration"/>
                                    <field name="location_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sport_club_coach_kanban" model="ir.ui.view">
        <field name="name">sport.club.coach.kanban</field>
        <field name="model">sport.club.coach</field>
        <field name="arch" type="xml">
            <kanban default_group_by="specialty">
                <field name="specialty"/>
                <field name="color"/>
                <field name="partner_id"/>
                <field name="is_active"/>
                <field name="image_256"/>
                <templates>
                    <t t-name="kanban-menu">
                        <t t-if="widget.editable">
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                    </t>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record d-flex justify-content-between align-items-center">

                            <div class="oe_kanban_content">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="specialty"/>
                                </div> <!-- Спеціальність тренера -->
                                <div class="mt-2">
                                    <t t-if="record.is_active.raw_value">
                                        <span class="badge bg-info text-white">Active</span>
                                    </t>
                                    <t t-if="!record.is_active.raw_value">
                                        <span class="badge bg-secondary text-white">Inactive</span>
                                    </t>
                                </div>
                            </div>

                             <field name="image_256" widget="image"
                                   class="oe_avatar oe_right"
                                   options="{'preview_image': 'image_256'}"
                                   style="max-width:150px;max-height:150px;"/>

                        </div>
                    </t>
                </templates>

                <!-- Групування тренерів за спеціальностями -->
                <group>
                    <field name="specialty"/>
                </group>
            </kanban>
        </field>
    </record>


    <record id="action_sport_club_coach" model="ir.actions.act_window">
        <field name="name">Coaches</field>
        <field name="res_model">sport.club.coach</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <menuitem id="menu_sport_club_coaches"
              name="Coaches"
              parent="sport_club_menu_main_doctor_patient"
              action="action_sport_club_coach"
              sequence="20"/>

</odoo>
