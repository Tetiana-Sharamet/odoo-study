<odoo>
    <record id="view_club_visit_tree" model="ir.ui.view">
        <field name="name">club.visit.tree</field>
        <field name="model">sport.club.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="visit_date"/>
                <field name="coach_id"/>
            </tree>
        </field>
    </record>

    <record id="view_club_visit_form" model="ir.ui.view">
        <field name="name">sport.club.visit.form</field>
        <field name="model">sport.club.visit</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id"/>
                    <field name="visit_date"/>
                    <field name="coach_id"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

     <record id="view_club_visit_graph" model="ir.ui.view">
        <field name="name">club.visit.graph</field>
        <field name="model">sport.club.visit</field>
        <field name="arch" type="xml">
            <graph string="Club Visits Graph" type="bar">
                <field name="visit_date" type="measure"/>
                <field name="partner_id" type="row"/>
            </graph>
        </field>
    </record>

     <record id="view_club_visit_pivot" model="ir.ui.view">
        <field name="name">sport.club.visit.pivot</field>
        <field name="model">sport.club.visit</field>
        <field name="arch" type="xml">
            <pivot string="Club Visits Pivot">
                <field name="partner_id" type="row"/>
                <field name="coach_id" type="col"/>
                <field name="visit_date" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_club_visit" model="ir.actions.act_window">
        <field name="name">Club Visits</field>
        <field name="res_model">sport.club.visit</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="help" type="html">
            <p>Create and manage club visit history.</p>
        </field>
    </record>

    <menuitem id="menu_club_visits" name="Club Visits"
              parent="menu_sport_club_root"
              action="action_club_visit"
              sequence="20"/>
</odoo>
