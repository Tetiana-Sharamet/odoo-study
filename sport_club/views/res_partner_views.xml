<odoo>
    <record id="view_partner_form_inherit_sport_club" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sport.club</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Sport Club">
                    <field name="is_club_member"/>
                    <field name="visits_count"/>
<!--                    <field name="is_coach"/>-->
                </group>
            </xpath>
        </field>
    </record>
</odoo>
