<odoo>
    <record id="view_sport_club_member_tree" model="ir.ui.view">
        <field name="name">sport.club.member.tree</field>
        <field name="model">sport.club.member</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="gender"/>
            </tree>
        </field>
    </record>

    <record id="view_sport_club_member_form" model="ir.ui.view">
        <field name="name">sport.club.member.form</field>
        <field name="model">sport.club.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="birth_date"/>
                        <field name="gender"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="active_subscription_id"/>
                        <field name="photo" widget="image" class="oe_avatar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sport_club_member_search" model="ir.ui.view">
        <field name="name">sport.club.member.search</field>
        <field name="model">sport.club.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <filter string="Male" domain="[('gender','=','male')]"/>
                <filter string="Female" domain="[('gender','=','female')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_sport_club_root"
              name="Sport Club"
              sequence="10"
              web_icon="sport_club_management,static/description/icon.png"/>

    <menuitem id="menu_sport_club_members"
              name="Members"
              parent="menu_sport_club_root"
              action="action_sport_club_member"
              sequence="10"/>

    <record id="action_sport_club_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">sport.club.member</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
