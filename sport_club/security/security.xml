<odoo>

    <!-- Access rules -->
    <record id="rule_sport_club_user_visit" model="ir.rule">
        <field name="name">access.sport.club.user</field>
        <field name="model_id" ref="model_sport_club_visit"/>
        <field name="groups" eval="[(4, ref('group_sport_club_user'))]"/>
        <field name="domain_force">[('session_id.coach_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

     <record id="rule_sport_club_user_training_session" model="ir.rule">
        <field name="name">access.sport.club.user</field>
        <field name="model_id" ref="model_sport_club_training_session"/>
        <field name="groups" eval="[(4, ref('group_sport_club_user'))]"/>
        <field name="domain_force">[('coach_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


    <record id="rule_sport_club_admin" model="ir.rule">
        <field name="name">access.sport.club.admin</field>
        <field name="model_id" ref="model_sport_club_visit"/>
        <field name="groups" eval="[(4, ref('group_sport_club_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
