<odoo>
    <record id="group_sport_club_user" model="res.groups">
        <field name="name">Sport Club User</field>
        <field name="category_id" ref="base.module_category_hr"/>
    </record>

    <record id="group_sport_club_admin" model="res.groups">
        <field name="name">Sport Club Admin</field>
        <field name="category_id" ref="base.module_category_hr"/>
    </record>

    <!-- Access rules -->
    <record id="access_sport_club_user" model="ir.model.access">
        <field name="name">access.sport.club.user</field>
        <field name="model_id" ref="model_club_visit"/>
        <field name="group_id" ref="group_sport_club_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_sport_club_admin" model="ir.model.access">
        <field name="name">access.sport.club.admin</field>
        <field name="model_id" ref="model_club_visit"/>
        <field name="group_id" ref="group_sport_club_admin"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
