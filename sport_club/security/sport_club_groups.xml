<odoo noupdate="1">
    <record id="sport_club" model="ir.module.category">
        <field name="name">Sport club</field>
        <field name="description">User access levels for the Club</field>
        <field name="sequence">1</field>
    </record>

    <record id="group_sport_club_user" model="res.groups">
        <field name="name">Sport Club User</field>
        <field name="category_id" ref="sport_club"/>
    </record>

    <record id="group_sport_club_admin" model="res.groups">
        <field name="name">Sport Club Admin</field>
        <field name="category_id" ref="sport_club"/>
        <field name="implied_ids" eval="[(4, ref('sport_club.group_sport_club_user'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Administrators(full rights)</field>
    </record>
</odoo>
