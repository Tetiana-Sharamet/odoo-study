<odoo>
    <record id="view_coach_performance_wizard_form" model="ir.ui.view">
        <field name="name">coach.performance.wizard.form</field>
        <field name="model">sport.club.coach.performance.wizard</field>
        <field name="arch" type="xml">
            <form string="Coach Performance Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                 <group>
                        <field name="coach_ids" widget="many2many_tags"/>
                    </group>
                <footer>
                    <button string="Print Report" type="object" name="action_print_report" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_coach_performance_wizard" model="ir.actions.act_window">
        <field name="name">Coach Performance Report</field>
        <field name="res_model">sport.club.coach.performance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_coach_performance_report"
            name="Coach Performance"
            parent="menu_coach_report_root"
            action="action_coach_performance_wizard"/>
</odoo>
