<odoo>
    <report
        id="action_report_certificate"
        model="club.visit"
        string="Certificate Report"
        report_type="qweb-pdf"
        name="sport_club.report_certificate"
        file="sport_club.report_certificate"
        attachment_use="False"
    />

    <template id="report_certificate">
        <t t-name="sport_club.report_certificate">
            <div class="page">
                <h2>Training Certificate</h2>
                <p>Trainer: <span t-field="doc.coach_id.name"/></p>
                <p>Participant: <span t-field="doc.partner_id.name"/></p>
                <p>Session Date: <span t-field="doc.visit_date"/></p>
            </div>
        </t>
    </template>
</odoo>
